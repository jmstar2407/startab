// Integrar DENTRO del match /databases/{database}/documents de las reglas actuales.
// Conservar los bloques existentes para categorías, accesos, historial y perfil.
match /users/{uid}/windowsDevices/{deviceId} {
  allow read, write: if request.auth != null && request.auth.uid == uid;
  match /pointerSessions/{sessionId} {
    allow read, write: if request.auth != null && request.auth.uid == uid;
  }
}
match /users/{uid}/tvDevices/{deviceId} {
  allow read, write: if request.auth != null && request.auth.uid == uid;
}
match /users/{uid}/mediaRemote/{documentId} {
  allow read, write: if request.auth != null && request.auth.uid == uid;
}
